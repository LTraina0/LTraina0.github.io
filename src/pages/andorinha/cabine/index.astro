---
import StudioHeader from '../../../components/StudioHeader.astro';
import AndorinhaNav from '../../../components/AndorinhaNav.astro';
import '../../../styles/andorinha.css';
const proposals=[['original','Cabine anterior'],['candidata','Cabine e galeria']];
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Cabine e galeria da Andorinha · BuildsMine</title></head>
<body>
<StudioHeader active="andorinha-cabine"><a class="studio-link" href="/inspecao/">Catálogo</a></StudioHeader>
<main class="ship-main">
  <AndorinhaNav active="cabine"/>
  <div class="ship-title"><h1>Cabine e galeria da Andorinha</h1><p>Janelas em dois registros, quartos salientes e cornijas sobre pilastras claras. Arraste uma vista para comparar com a cabine original.</p></div>
  <div class="ship-fields timeline">
    <label>Vista <select id="view">
      <option value="perspectiva">Popa em três quartos</option><option value="geral">Navio completo</option><option value="popa">Espelho de popa</option><option value="lateral">Lateral</option><option value="superior">Cobertura</option><option value="inferior">Consolos inferiores</option><option value="janela">Janela de quarto</option><option value="jogador">Entrada do jogador</option><option value="interior">Salão e claraboia</option>
    </select></label>
    <label>Ambiente <select id="ambiente"><option value="neutro">Luz neutra</option><option value="glacial">Glacial · anoitecer</option></select></label>
    <label><input id="isolate" type="checkbox"/> Isolar cabine e galeria</label><button id="reset" type="button">Repor câmera</button>
  </div>
  <section class="pair-surfaces costado-surfaces" aria-label="Cabine anterior e candidata na mesma câmera">
    {proposals.map(([id,name])=><article class="ship-surface pair-surface"><h2 class="pair-caption"><b>{id==='original'?'Base':'Candidata'}</b> {name}</h2><div class="ship-stage" id={'scene-'+id} aria-label={'Modelo 3D · '+name}></div></article>)}
  </section>
  <p class="ship-footer" role="status" id="status">Carregando a cabine…</p>
  <details class="native-evidence timeline" open><summary>Fotografias do Minecraft Editor</summary>
    <div class="native-links"><a href="./editor-wayblex-noite.jpg">Revisão Wayblex · inspeção no Editor</a></div>
    <details><summary>Registros da primeira construção</summary><div class="native-links"><a href="./editor-perspectiva.jpg">Conjunto anterior</a><a href="./editor-popa.jpg">Espelho anterior</a><a href="./editor-inferior.jpg">Primeiros consolos</a><a href="./editor-superior.jpg">Primeira cobertura</a><a href="./editor-jogador.jpg">Acesso</a><a href="./editor-detalhes.jpg">Janelas anteriores</a></div></details>
  </details>
</main></body></html>
<style>
.native-evidence p{margin-top:8px;font-size:14px;max-width:80ch}
.costado-surfaces{grid-template-columns:repeat(2,minmax(0,1fr))}
.costado-surfaces .ship-stage{height:clamp(320px,39vw,690px)}
@media(max-width:800px){.costado-surfaces{grid-template-columns:1fr}.costado-surfaces .ship-stage{height:clamp(230px,49vw,320px)}}
</style>
<script>
import {createRoofScene} from '../../../scripts/roof-scene.js';
import {createRoofAssets} from '../../../scripts/roof-assets.js';

const el=id=>document.getElementById(id);
const ids=['original','candidata'];
// Orthographic width in blocks, target and orbit direction. Deck uses eye position.
const views={
 perspectiva:{target:[28,15,-3],width:32,dir:[1,.29,.78]},
 geral:{target:[-3,21,-1],width:103,dir:[.3,.25,1]},
 popa:{target:[31,15.7,-3],width:30,dir:[1,.05,0]},
 lateral:{target:[28,16,-3],width:31,dir:[0,.08,1]},
 superior:{target:[28,16,-3],width:31,dir:[.2,1,.3]},
 inferior:{target:[30,12,-3],width:29,dir:[.65,-.32,.8]},
 janela:{target:[29,16.4,3],width:12,dir:[.35,.06,1]},
 jogador:{target:[27,15.5,-3],eye:[18.5,15.6,-3]},
 interior:{target:[33,16,-3],eye:[24.5,15.6,-3]}};
const isPatch=b=>b.module==='cabine';
async function start(){
 const r=await fetch('./modelos.json');if(!r.ok)throw Error('Falha ao carregar a geometria');
 const data=await r.json(),catalog=await fetch('./catalogo.json').then(r=>r.json()),assets=await createRoofAssets(catalog);
 function addRows(map,rows){
   for(let i=0;i<rows.length;i+=4){
     const [x,y,z,k]=rows.slice(i,i+4),key=[x,y,z].join();
     if(k<0){map.delete(key);continue}
     const [id,states,module,component]=data.dictionary[k];map.set(key,{x,y,z,id,states,module,component});
   }
   return map;
 }
 const panes=ids.map(id=>{
   const blocks=Array.from(addRows(new Map(),data.sets[id]).values());
   const host=el('scene-'+id);
   const scene=createRoofScene(host,assets,b=>{if(b)el('status').textContent=id+' · '+b.component+' · '+b.id+' · '+[b.x,b.y,b.z].join(', ')});
   return {scene,host,blocks};
 });
 let syncing=false;
 function filter(){
   const glacial=el('ambiente').value==='glacial',isolated=el('isolate').checked;
   const reverse=false;
   for(const {scene,blocks} of panes){
     const visible=blocks.filter(b=>(!isolated||isPatch(b))&&(!reverse||b.z>=2)&&
       (glacial||!['gelo','destrocos'].includes(b.module)&&b.id!=='minecraft:snow_layer'));
     scene.filter(new Set(visible));
   }
   el('status').textContent=assets.failures.length?'Texturas indisponíveis · '+assets.failures.join(', '):
     (glacial?'Gelo e neve originais · luz polar':'Luz neutra')+' · Câmeras vinculadas'+(reverse?' · Corte longitudinal em Z = 2':'');
 }
 function environment(){
   const glacial=el('ambiente').value==='glacial';
   for(const {scene,blocks} of panes){scene.load({blocks,polar:glacial});scene.lighting(glacial)}
   filter();
 }
 function reset(){
   syncing=true;
   try{
     const {scene,host}=panes[0],v=views[el('view').value],t=v.target;
     if(v.eye){scene.fit('perspective',[{x:t[0],y:t[1],z:t[2]}]);scene.camera.position.set(...v.eye)}
     else{
       const wide=v.width/2,high=Math.min(wide*.7,wide/(host.clientWidth/host.clientHeight));
       scene.fit('front',[{x:t[0]-wide,y:t[1]-high,z:t[2]},{x:t[0]+wide-1,y:t[1]+high-1,z:t[2]-1}]);
       scene.camera.position.set(...v.dir).normalize().multiplyScalar(90);scene.camera.position.x+=t[0];scene.camera.position.y+=t[1];scene.camera.position.z+=t[2];
     }
     scene.controls.target.set(...t);scene.controls.update();scene.draw();
     for(const p of panes.slice(1))p.scene.matchView(scene);
   }finally{syncing=false}
 }
 panes.forEach(({scene})=>scene.controls.addEventListener('change',()=>{
   if(syncing)return;syncing=true;try{for(const p of panes)if(p.scene!==scene)p.scene.matchView(scene)}finally{syncing=false}
 }));
 el('view').onchange=()=>{filter();reset()};el('ambiente').onchange=environment;el('isolate').onchange=filter;el('reset').onclick=reset;
 let prev='';
 new ResizeObserver(()=>{const h=panes[0].host,key=h.clientWidth+','+h.clientHeight;if(key!==prev){prev=key;reset()}}).observe(panes[0].host);
 environment();reset();document.body.dataset.ready='true';
}
start().catch(e=>{el('status').textContent='Falha ao abrir a cabine · '+e.message});
</script>
