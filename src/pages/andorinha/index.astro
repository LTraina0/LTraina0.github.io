---
import StudioHeader from '../../components/StudioHeader.astro';
import {navalArchive} from '../../data/studio-projects.js';
import '../../styles/andorinha.css';
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Andorinha — O Último Encalhe · BuildsMine</title></head>
<body>
<StudioHeader active="andorinha-ultimo-encalhe"><a class="studio-link" href="/inspecao/">Catálogo</a></StudioHeader>
<main class="ship-main">
  <nav class="ship-nav" aria-label="Projeto Andorinha">
    <div class="ship-tabs" role="group" aria-label="Explorar a construção">
      <button type="button" data-view="ship" aria-pressed="true">Embarcação</button>
      <button type="button" data-view="rig" aria-pressed="false">Mastros e velas</button>
      <button type="button" data-view="cabin" aria-pressed="false">Cabine e galeria</button>
      <button type="button" id="sample-tab" aria-pressed="false">Amostra modular R1</button>
    </div>
    <details class="ship-archive"><summary>Acervo naval</summary><ul>{navalArchive.map(([name,href])=><li><a href={href}>{name}</a></li>)}</ul></details>
  </nav>
  <div class="ship-title"><h1>Andorinha — O Último Encalhe</h1><p>Versão B · Lugre e vela rizada · cabine e galeria</p></div>
  <div id="viewer-controls" class="ship-fields timeline">
    <label>Vista <select id="view"><option value="ship">Geral</option><option value="lateral">Lateral</option><option value="top">Superior</option><option value="cabin">Cabine e galeria</option><option value="rupture">Ruptura</option><option value="rig">Mastros e velas</option></select></label>
    <label>Mostrar <select id="module"><option value="all">Conjunto completo</option><option value="ship">Navio</option><option value="rig">Mastros e velas</option><option value="cabin">Cabine e galeria</option><option value="wreck">Destroços</option><option value="ice">Gelo e neve</option></select></label>
    <label><input id="compare" type="checkbox"/> Comparar mastros e velas A/B</label>
    <button id="reset" type="button">Repor câmera</button>
  </div>
  <p id="compare-note" class="comparison-note" hidden>As duas vistas usam o casco e a cabine atuais; a diferença está nos mastros e velas.</p>
  <section id="surfaces" class="surfaces" aria-label="Visualização da Andorinha">
    <article id="paneA" class="ship-surface pair-surface" hidden><h2 class="pair-caption">A · Panos redondos</h2><div id="sceneA" class="ship-stage" aria-label="Proposta A"></div></article>
    <article class="ship-surface pair-surface"><h2 id="captionB" class="pair-caption" hidden>B · Lugre e vela rizada</h2><div id="sceneB" class="ship-stage" aria-label="Andorinha versão B"></div></article>
  </section>
  <section id="sample" hidden aria-label="Amostra modular R1">
    <p class="sample-description">Amostra de cabine construída no Minecraft Editor para avaliação. A versão B permanece como construção principal.</p>
    <div class="ship-fields timeline"><label>Vista <select id="sample-view"><option value="tres-quartos-dia">Três quartos · dia</option><option value="frontal-dia">Popa · dia</option><option value="lateral-dia">Lateral · dia</option><option value="inferior-dia">Apoios · inferior</option><option value="reverso-janela-dia">Interior · janela</option><option value="tres-quartos-noite">Três quartos · noite</option><option value="portal-fechado-final">Portal · fechado</option><option value="portal-aberto-final">Portal · aberto</option></select></label><a href="/andorinha/amostra-r1/caderno.pdf">Abrir caderno técnico</a></div>
    <figure class="ship-surface sample-figure"><img id="sample-image" src="/andorinha/amostra-r1/tres-quartos-dia.png" alt="Amostra modular R1 vista em três quartos no Minecraft Editor"/><figcaption>Captura real do Minecraft Editor · amostra de teste, ainda não integrada à cabine definitiva.</figcaption></figure>
  </section>
  <p id="status" class="ship-footer" role="status">Carregando a embarcação…</p>
</main></body></html>
<style>
.ship-tabs button{border:0;background:transparent;color:var(--ink);font:inherit;font-size:13px;font-weight:600;padding:9px 12px;cursor:pointer}
.ship-tabs button[aria-pressed=true]{background:var(--panel);box-shadow:inset 0 -3px var(--focus)}
.ship-tabs button:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.surfaces{display:grid;grid-template-columns:minmax(0,1fr);gap:10px}
.surfaces.comparing{grid-template-columns:repeat(2,minmax(0,1fr))}
.surfaces [hidden]{display:none}
.comparison-note{font-size:13px;color:#34463e}
.sample-figure{margin:0}.sample-figure img{display:block;width:100%;height:auto}.sample-figure figcaption{padding:8px;font-size:13px}.sample-description{margin:6px 0!important;font-size:14px}
#viewer-controls[hidden],#surfaces[hidden],#sample[hidden],#status[hidden],#compare-note[hidden]{display:none!important}
.surfaces .ship-stage{height:clamp(310px,62vh,820px)}
@media(max-width:740px){.surfaces.comparing{grid-template-columns:1fr}.surfaces.comparing .ship-stage{height:clamp(250px,43vh,430px)}}
</style>
<script>
import {createRoofScene} from '../../scripts/roof-scene.js';
import {createRoofAssets} from '../../scripts/roof-assets.js';
const el=id=>document.getElementById(id);
const poses={
 ship:[[-4,21,4],46,[.16,.24,1]], lateral:[[-4,21,4],46,[0,.03,1]],
 top:[[-4,14,0],46,[.01,1,.01]],cabin:[[28,15,-3],18,[.65,.18,1]],
 rupture:[[0,15,0],17,[.25,.18,1]],rig:[[-3,26,0],37,[0,.03,1]]
};
async function start(){
 const response=await fetch('/andorinha/aparelho/comparacao.json');
 if(!response.ok)throw Error('Geometria indisponível');
 const data=await response.json(),assets=await createRoofAssets(data.catalog);
 function expand(rows){const out=[];for(let i=0;i<rows.length;i+=4){const [id,states,module,component]=data.dictionary[rows[i+3]];out.push({x:rows[i],y:rows[i+1],z:rows[i+2],id,states,module,component})}return out}
 const base=expand(data.sets.baseB);
 const models={A:[...base,...expand(data.sets.A)],B:[...base,...expand(data.sets.B)]};
 const scenes={};
 for(const id of ['A','B']){
  scenes[id]=createRoofScene(el('scene'+id),assets,b=>{if(b)el('status').textContent=b.component+' · '+b.id+' · '+[b.x,b.y,b.z].join(', ')});
  scenes[id].load({blocks:models[id],naval:true});scenes[id].lighting(false);
 }
 let syncing=false;
 const active=()=>el('compare').checked?['A','B']:['B'];
 function filter(){
  const part=el('module').value;
  for(const id of ['A','B']){
   const blocks=models[id].filter(b=>part==='all'||part==='ship'&&!['gelo','destrocos'].includes(b.module)||part==='rig'&&b.module==='velame'||part==='cabin'&&b.module==='cabine'||part==='wreck'&&b.module==='destrocos'||part==='ice'&&b.module==='gelo');
   scenes[id].filter(new Set(blocks));
  }
  el('status').textContent=assets.failures.length?'Texturas indisponíveis · '+assets.failures.join(', '):'Luz neutra · arraste para girar · selecione um bloco';
 }
 function reset(){
  syncing=true;
  const [target,halfWidth,direction]=poses[el('view').value],host=el('sceneB'),aspect=host.clientWidth/host.clientHeight;
  if(!aspect){syncing=false;return}
  const h=Math.max(halfWidth/aspect,halfWidth*.56),w=h*aspect,[x,y,z]=target;
  for(const id of active()){
   const scene=scenes[id];scene.fit('front',[{x:x-w,y:y-h,z},{x:x+w-1,y:y+h-1,z:z-1}]);
   scene.controls.target.set(x,y,z);scene.camera.position.set(...direction).normalize().multiplyScalar(125).add(scene.controls.target);
   scene.camera.zoom=1.05;scene.camera.updateProjectionMatrix();scene.controls.update();scene.draw();
  }
  syncing=false;
 }
 for(const id of ['A','B'])scenes[id].controls.addEventListener('change',()=>{if(syncing||!el('compare').checked)return;syncing=true;scenes[id==='A'?'B':'A'].matchView(scenes[id]);syncing=false});
 function layout(){const compare=el('compare').checked;el('paneA').hidden=!compare;el('captionB').hidden=!compare;el('compare-note').hidden=!compare;el('surfaces').classList.toggle('comparing',compare);requestAnimationFrame(reset)}
 function view(){document.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===el('view').value)));reset()}
 document.querySelectorAll('[data-view]').forEach(button=>button.addEventListener('click',()=>{el('sample').hidden=true;el('viewer-controls').hidden=false;el('surfaces').hidden=false;el('status').hidden=false;el('sample-tab').setAttribute('aria-pressed','false');el('view').value=button.dataset.view;el('module').value='all';filter();layout();view()}));
 el('sample-tab').onclick=()=>{document.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-pressed','false'));el('sample-tab').setAttribute('aria-pressed','true');el('viewer-controls').hidden=true;el('surfaces').hidden=true;el('compare-note').hidden=true;el('status').hidden=true;el('sample').hidden=false};
 el('sample-view').onchange=()=>{el('sample-image').src='/andorinha/amostra-r1/'+el('sample-view').value+'.png'};
 el('view').onchange=view;el('module').onchange=filter;el('compare').onchange=layout;el('reset').onclick=reset;
 let previous='';new ResizeObserver(()=>{const host=el('sceneB'),size=host.clientWidth+','+host.clientHeight;if(size!==previous){previous=size;reset()}}).observe(el('sceneB'));
 filter();layout();document.body.dataset.ready='true';
}
start().catch(e=>{el('status').textContent='Falha ao abrir a embarcação · '+e.message});
</script>
