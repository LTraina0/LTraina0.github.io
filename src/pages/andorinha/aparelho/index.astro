---
import StudioHeader from '../../../components/StudioHeader.astro';
import AndorinhaNav from '../../../components/AndorinhaNav.astro';
import '../../../styles/andorinha.css';
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Comparar mastros e velas da Andorinha · BuildsMine</title></head>
<body>
<StudioHeader active="andorinha-aparelho"><a class="studio-link" href="/inspecao/">Catálogo</a></StudioHeader>
<main class="ship-main">
  <AndorinhaNav active="review"/>
  <div class="ship-title"><h1>Mastros e velas da Andorinha</h1><p>A proposta B, Lugre e vela rizada, recebeu a nova cabine e galeria. Câmeras vinculadas e luz neutra.</p></div>
  <div class="ship-fields timeline">
    <label>Estado
      <select id="stage"><option value="base">Base preservada</option><option value="current" selected>Refinamento atual</option></select>
    </label>
    <label>Enquadramento
      <select id="view">
        <option value="ship">Navio inteiro</option><option value="rig">Aparelho de frente</option><option value="cabin">Cabine e galeria</option>
        <option value="oblique">Aparelho em três quartos</option><option value="bow">Vela de vante</option>
        <option value="stern">Vela de popa</option><option value="crown">Gávea e encaixes</option>
        <option value="profile">Perfil da vela</option><option value="foot">Pé do mastro</option>
        <option value="reverse">Avesso da vela de popa</option><option value="cloth">Tecido e vidro de perto</option>
      </select>
    </label>
    <label>Mostrar
      <select id="module"><option value="all">Conjunto completo</option><option value="sails">Velas e vergas</option><option value="crowns">Gáveas e fixações</option></select>
    </label>
    <label><input id="isolate" type="checkbox"/> Isolar aparelho</label><button id="reset" type="button">Repor câmera</button>
  </div>

  <section class="pair-surfaces" aria-label="Comparação das duas propostas">
    {[['A','Panos redondos'],['B','Lugre e vela rizada']].map(([id,name])=>
      <article class="ship-surface pair-surface">
        <h2 class="pair-caption"><b>{id}</b> {name}</h2>
        <div id={'scene'+id} class="ship-stage" aria-label={'Modelo tridimensional · '+name}></div>
      </article>)}
  </section>
  <p class="ship-footer" id="status" role="status">Carregando os dois aparelhos…</p>
  <details class="native-evidence timeline" open>
    <summary>Capturas do Minecraft Editor</summary>
    <div class="native-links">
      <a href="./refinamento-A-antes-depois.jpg">Panos redondos · antes e depois</a>
      <a href="./refinamento-B-antes-depois.jpg">Lugre e vela rizada · antes e depois</a>
      <a href="./refinamento-avessos.jpg">Avesso dos panos</a>
      <a href="./refinamento-detalhes.jpg">Tecido, vidro e gáveas de perto</a>
    </div>
    <details class="earlier-captures">
      <summary>Capturas anteriores</summary>
      <div class="native-links"><a href="./curvatura-A-B.jpg">Velas de popa · comparar A e B</a><a href="./curvatura-antes-depois.jpg">Curvatura de A · antes e depois</a><a href="./editor-comparado.jpg">Comparação das duas propostas no Editor</a><a href="./edicao-no-editor.jpg">Dobra da vela de popa · antes e depois da edição</a></div>
    </details>
  </details>
</main>
</body></html>
<style>
  .earlier-captures{margin-top:12px}
  .earlier-captures summary{font-size:13px;font-weight:500}
  .ship-fields #stage{flex:none;min-height:34px;overflow:visible;border-width:2px;background:var(--button);border-color:var(--hi) var(--lo) var(--lo) var(--hi)}
</style>
<script>
import {createRoofScene} from '../../../scripts/roof-scene.js';
import {createRoofAssets} from '../../../scripts/roof-assets.js';
const el=id=>document.getElementById(id);
const poses={
 ship:[[-4,21,4],46,[.16,.24,1]],cabin:[[28,15,-3],18,[.65,.18,1]],rig:[[-3,26,0],37,[0,.03,1]],
 oblique:[[-3,29,0],35,[.51,.24,1]],bow:[[-21,29,3],16,[.28,.15,1]],
 stern:[[14,32,0],17,[.18,.11,1]],crown:[[14,39,-2],9,[.57,.38,1]],
 profile:[[14,31,-1],16,[-1,.12,.23]],foot:[[-21,15,2],8,[.55,.35,1]],
 reverse:[[14,32,0],16,[-.37,.12,-1]],cloth:[[-20,27,5],10,[.39,.13,1]]};

async function loadState(path){
 const response=await fetch(path);
 if(!response.ok)throw Error('Não foi possível carregar '+path);
 const data=await response.json();
 const expand=arr=>{
   const blocks=[];
   for(let i=0;i<arr.length;i+=4){
     const [id,states,module,component]=data.dictionary[arr[i+3]];
     blocks.push({x:arr[i],y:arr[i+1],z:arr[i+2],id,states,module,component});
   }
   return blocks;
 };
 const proposals=Object.fromEntries(['A','B'].map(key=>{
   const fixed=expand(data.sets['base'+key]??data.sets.base);
   const rig=expand(data.sets[key]);
   const sails=rig.filter(b=>isCloth(b)||/verga|envergamento|penol|geada na testa|cinta de rizar|escarva|entalhe de meia-madeira/i.test(b.component));
   const crowns=rig.filter(b=>!isCloth(b)&&(
     /gávea|guarda|cabeço|balaústre|plataforma|adriça|moitão|talha|cinta do mastro|fixação|coxim|colar e braço|abraçadeira|ligação/i.test(b.component)||
     b.y>=(b.x<0?31:34)&&/mast(aréu|ro)|árvore|cruzeta|estribo/i.test(b.component)
   ));
   return [key,{all:[...fixed,...rig],rig,sails,crowns}];
 }));
 return {proposals,catalog:data.catalog};
}
function isGlass(b){return /:(?:glass|[a-z_]+_stained_glass)$/.test(b.id)}
function isCloth(b){return /_wool(?:_slab|_stairs)?$/.test(b.id)||isGlass(b)}
function setClothView(proposals){
 const glass=['A','B'].map(id=>proposals[id].rig.filter(isGlass));
 const half=glass.every(cells=>cells.some(b=>b.x<0))?-1:1;
 const near=glass.flat().filter(b=>half<0?b.x<0:b.x>=0);
 if(!near.length)return;
 const extent=axis=>{
   const values=near.map(b=>b[axis]);
   return [Math.min(...values),Math.max(...values)+1];
 };
 const ranges=['x','y','z'].map(extent);
 const center=ranges.map(([lo,hi])=>(lo+hi)/2);
 const halfWidth=Math.max(6, ...ranges.map(([lo,hi])=>(hi-lo)/2+3));
 poses.cloth=[center,halfWidth,[.38,.13,1]];
}
async function compare(){
 const [current,base]=await Promise.all([loadState('./comparacao.json'),loadState('./base-refinamento.json')]);
 const states={current,base};
 const assets=await createRoofAssets({...base.catalog,...current.catalog});
 setClothView(current.proposals);
 const pairs=['A','B'].map(id=>{
   const scene=createRoofScene(el('scene'+id),assets,b=>{if(b)el('status').textContent=id+' · '+b.component+' · '+b.id+' · '+[b.x,b.y,b.z].join(', ')});
   return {id,scene};
 });
 let syncing=false;
 const status=()=>assets.failures.length?'Falhas de textura · '+assets.failures.join(', '):'Luz neutra · câmeras vinculadas · arraste para girar ou selecione um bloco.';
 const active=()=>states[el('stage').value].proposals;
 function showParts(){
   const part=el('module').value,isolate=el('isolate');
   // A named subset already isolates its geometry. Preserve the user's full-rig
   // checkbox preference when they switch back to the complete model.
   isolate.disabled=part!=='all';
   for(const {id,scene} of pairs){
     const model=active()[id];
     const visible=part==='all'?(isolate.checked?model.rig:model.all):model[part];
     scene.filter(new Set(visible));
   }
   el('status').textContent=status()+(part==='all'&&isolate.checked?' · O piso sob o mastro de popa aparece no navio inteiro.':'');
 }
 function showState(){
   for(const {id,scene} of pairs){
     scene.load({blocks:active()[id].all,naval:true});
     scene.lighting(false);
   }
   showParts();
   document.body.dataset.stage=el('stage').value;
 }
 function reset(){
   syncing=true;
   const [center,halfWidth,direction]=poses[el('view').value];
   const [x,y,z]=center,pane=el('sceneA'),aspect=pane.clientWidth/pane.clientHeight;
   const halfHeight=Math.max(halfWidth/aspect,halfWidth*(el('view').value==='ship'?.56:el('view').value==='rig'?.63:el('view').value==='oblique'?.59:.84));
   for(const {scene} of pairs){
     const w=halfHeight*aspect,h=halfHeight;
     scene.fit('front',[{x:x-w,y:y-h,z},{x:x+w-1,y:y+h-1,z:z-1}]);
     scene.controls.target.set(x,y,z);const cam=scene.camera;
     cam.position.set(...direction).normalize().multiplyScalar(125).add(scene.controls.target);
     cam.zoom=1.14;cam.updateProjectionMatrix();scene.controls.update();scene.draw();
   }
   syncing=false;el('status').textContent=status();
 }
 for(let i=0;i<2;i++)pairs[i].scene.controls.addEventListener('change',()=>{
   if(syncing)return;syncing=true;pairs[1-i].scene.matchView(pairs[i].scene);syncing=false;
 });
 el('view').onchange=reset;el('isolate').onchange=showParts;el('module').onchange=showParts;
 el('stage').onchange=showState;el('reset').onclick=reset;
 let lastSize='';
 new ResizeObserver(entries=>{
   const {width,height}=entries[0].contentRect,size=width+','+height;
   if(width&&height&&lastSize!==size){lastSize=size;reset()}
 }).observe(el('sceneA'));
 showState();reset();document.body.dataset.ready='true';
}
compare().catch(e=>{el('status').textContent='Falha ao abrir a comparação · '+e.message});
</script>
