---
import StudioHeader from '../../../components/StudioHeader.astro';
import AndorinhaNav from '../../../components/AndorinhaNav.astro';
import '../../../styles/andorinha.css';
const proposals=[['original','Costado original'],['C1','Carmesim estratificado'],['C2','Carmesim sombreado']];
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Costado da Andorinha · BuildsMine</title></head>
<body>
<StudioHeader active="andorinha-costado"><a class="studio-link" href="/inspecao/">Catálogo</a></StudioHeader>
<main class="ship-main">
  <AndorinhaNav active="costado"/>
  <div class="ship-title"><h1>Costado da Andorinha</h1><p>Dezessete blocos de cinta rubra sob a galeria de popa. Arraste qualquer vista para girar as três juntas.</p></div>
  <div class="ship-fields timeline">
    <label>Vista <select id="view">
      <option value="obliqua">Costado em três quartos</option><option value="lateral">Elevação lateral</option><option value="junta">Encontro com a caverna</option><option value="inferior">Friso inferior</option><option value="verso">Verso da cinta</option><option value="distante">Popa à distância</option><option value="conves">Do convés</option>
    </select></label>
    <label>Ambiente <select id="ambiente"><option value="neutro">Luz neutra</option><option value="glacial">Glacial · gelo e neve da Andorinha</option></select></label>
    <label><input id="isolate" type="checkbox"/> Isolar os 17 blocos de costado</label><button id="reset" type="button">Repor câmera</button>
  </div>
  <section class="pair-surfaces costado-surfaces" aria-label="Costado original e alternativas na mesma câmera">
    {proposals.map(([id,name])=><article class="ship-surface pair-surface"><h2 class="pair-caption"><b>{id==='original'?'Base':id}</b> {name}</h2><div class="ship-stage" id={'scene-'+id} aria-label={'Modelo 3D · '+name}></div></article>)}
  </section>
  <p class="ship-footer" role="status" id="status">Carregando o costado…</p>
  <details class="native-evidence timeline"><summary>Parecer da rodada</summary>
    <p><strong>C1.</strong> As três molduras sustentam a continuidade rubra. De perto, a repetição dos peitoris lhes dá um perfil de banco.</p>
    <p><strong>C2.</strong> Os três apoios acompanham a curva da popa. O nicho recua entre os tijolos escuros e o ponto de luz some na oblíqua. A crítica recomenda refinar este painel sob a cabine.</p>
  </details>
  <details class="native-evidence timeline" open><summary>Fotografias do Minecraft Editor</summary>
    <div class="native-links"><a href="./editor-lateral.jpg">Cintas e aberturas</a><a href="./editor-junta.jpg">Juntas e nervuras de perto</a><a href="./editor-obliqua.jpg">Relevo em três quartos</a><a href="./editor-conves.jpg">Do convés</a><a href="./editor-distante.jpg">Leitura à distância</a></div>
  </details>
</main></body></html>
<style>
.native-evidence p{margin-top:8px;font-size:14px;max-width:80ch}
.costado-surfaces{grid-template-columns:repeat(3,minmax(0,1fr))}
.costado-surfaces .ship-stage{height:clamp(245px,26vw,540px)}
@media(max-width:800px){.costado-surfaces{grid-template-columns:1fr}.costado-surfaces .ship-stage{height:clamp(230px,49vw,320px)}}
</style>
<script>
import {createRoofScene} from '../../../scripts/roof-scene.js';
import {createRoofAssets} from '../../../scripts/roof-assets.js';
import {costadoCatalog} from '../../../../architect/v3/costado-catalog.mjs';
const el=id=>document.getElementById(id);
const ids=['original','C1','C2'];
// Orthographic width in blocks, target and orbit direction. Deck uses eye position.
const views={
 obliqua:{target:[24.5,7.8,5],width:21,dir:[.48,.15,1]},
 lateral:{target:[24.5,7.8,5],width:21,dir:[0,.015,1]},
 junta:{target:[26.3,8.5,5],width:9,dir:[.48,.13,1]},
 inferior:{target:[23.5,5.5,4.2],width:15,dir:[-.38,-.12,1]},
 verso:{target:[24,8,4],width:19,dir:[-.34,.09,-1]},
 distante:{target:[21,12,0],width:47,dir:[.34,.23,1]},
 conves:{target:[26.5,8,5.8],eye:[18.5,13.1,7.45]}};
const isPatch=b=>b.x>=16&&b.x<=32&&b.y>=4&&b.y<=11&&b.z>=2&&b.z<=7;
async function start(){
 const r=await fetch('./modelos.json');if(!r.ok)throw Error('Falha ao carregar a geometria');
 const data=await r.json(),assets=await createRoofAssets(costadoCatalog(data.dictionary));
 function addRows(map,rows){
   for(let i=0;i<rows.length;i+=4){
     const [x,y,z,k]=rows.slice(i,i+4),key=[x,y,z].join();
     if(k<0){map.delete(key);continue}
     const [id,states,module]=data.dictionary[k];map.set(key,{x,y,z,id,states,module});
   }
   return map;
 }
 const base=addRows(new Map(),data.base);
 const panes=ids.map(id=>{
   const blocks=Array.from(addRows(new Map(base),data.patches[id]||[]).values());
   const host=el('scene-'+id);
   const scene=createRoofScene(host,assets,b=>{if(b)el('status').textContent=id+' · '+b.id+' · '+[b.x,b.y,b.z].join(', ')});
   return {scene,host,blocks};
 });
 let syncing=false;
 function filter(){
   const glacial=el('ambiente').value==='glacial',isolated=el('isolate').checked;
   const reverse=el('view').value==='verso';
   for(const {scene,blocks} of panes){
     const visible=blocks.filter(b=>(!isolated||isPatch(b))&&(!reverse||b.z>=2)&&
       (glacial||!['gelo','destrocos'].includes(b.module)&&b.id!=='minecraft:snow_layer'));
     scene.filter(new Set(visible));
   }
   el('status').textContent=assets.failures.length?'Texturas indisponíveis · '+assets.failures.join(', '):
     (glacial?'Gelo e neve originais · luz polar':'Luz neutra')+' · Câmeras vinculadas'+(reverse?' · Corte longitudinal em Z = 2':'');
 }
 function environment(){
   const glacial=el('ambiente').value==='glacial';
   for(const {scene,blocks} of panes){scene.load({blocks,polar:glacial});scene.lighting(false)}
   filter();
 }
 function reset(){
   syncing=true;
   try{
     const {scene,host}=panes[0],v=views[el('view').value],t=v.target;
     if(v.eye){scene.fit('perspective',[{x:t[0],y:t[1],z:t[2]}]);scene.camera.position.set(...v.eye)}
     else{
       const wide=v.width/2,high=Math.min(wide*.7,wide/(host.clientWidth/host.clientHeight));
       scene.fit('front',[{x:t[0]-wide,y:t[1]-high,z:t[2]},{x:t[0]+wide-1,y:t[1]+high-1,z:t[2]-1}]);
       scene.camera.position.set(...v.dir).normalize().multiplyScalar(90);scene.camera.position.x+=t[0];scene.camera.position.y+=t[1];scene.camera.position.z+=t[2];
     }
     scene.controls.target.set(...t);scene.controls.update();scene.draw();
     for(const p of panes.slice(1))p.scene.matchView(scene);
   }finally{syncing=false}
 }
 panes.forEach(({scene})=>scene.controls.addEventListener('change',()=>{
   if(syncing)return;syncing=true;try{for(const p of panes)if(p.scene!==scene)p.scene.matchView(scene)}finally{syncing=false}
 }));
 el('view').onchange=()=>{filter();reset()};el('ambiente').onchange=environment;el('isolate').onchange=filter;el('reset').onclick=reset;
 let prev='';
 new ResizeObserver(()=>{const h=panes[0].host,key=h.clientWidth+','+h.clientHeight;if(key!==prev){prev=key;reset()}}).observe(panes[0].host);
 environment();reset();document.body.dataset.ready='true';
}
start().catch(e=>{el('status').textContent='Falha ao abrir o costado · '+e.message});
</script>
