---
const designs=[
 ['original','Escotilha atual','Grelhas embutidas, escada lateral e turco de um só pé.'],
 ['claraboia','Claraboia de duas águas','Dois frontões escuros enquadram o vidro marrom. A luz entra pelo trecho de vante e a escada fica descoberta.'],
 ['portico','Pórtico de carga','Dois pés sustentam o vau transversal. A corrente desce ao lado da escada, sobre o poço aberto.']
];
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Escotilha da Andorinha · BuildsMine</title></head><body>
<main><a href="/?build=andorinha-carpintaria">← BuildsMine · Popa da Andorinha</a>
<h1>A escotilha da Andorinha</h1><p>O mesmo trecho de convés em três montagens, visto de vante. Selecione uma para inspecionar seus blocos.</p>
<div class="cards">{designs.map(([id,name,desc])=><article><button type="button" data-id={id}><img src={'./'+id+'.webp'} alt={name+' vista do convés'}/><strong>{name}</strong></button><p>{desc}</p>{id!=="original" && <a href={"./"+id+".mcstructure"} download>Recorte Bedrock · 11 × 15 × 11</a>}</article>)}</div>
<section><h2 id="name">Claraboia de duas águas</h2><label>Enquadramento <select id="camera"><option value="hatchDetail">Escotilha</option><option value="avante">Popa e painel</option><option value="top">Planta</option><option value="front">Espelho</option><option value="back">Vante</option><option value="left">Bombordo</option><option value="right">Boreste</option><option value="bottom">Fundo</option></select></label> <label>Corte <select id="cut"><option value="all">Inteiro</option><option value="half">Longitudinal</option><option value="deck">Até o convés</option></select></label><div id="model"></div><p id="status" role="status">Carregando o modelo…</p></section></main>
<style>html{background:#efece4;color:#2f302d;font:16px/1.45 system-ui}main{max-width:90rem;margin:auto;padding:2vw}a{color:#325e5a}h1,h2,strong{font-family:Georgia,serif}h1{font-size:clamp(2rem,4vw,3.4rem);margin:.45em 0 0}h2{margin:.55em 0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}.cards img{display:block;width:100%;aspect-ratio:1.6;object-fit:cover}.cards button{cursor:pointer;background:#f9f7f1;color:inherit;border:2px solid transparent;width:100%;padding:0;text-align:left}.cards button[aria-pressed=true]{border-color:#28605a}.cards strong{display:block;padding:.45rem;font-size:1.35rem}.cards p{margin:.4rem}.cards article{min-width:0}select{font:inherit;margin:.3em}#model{height:clamp(320px,65vh,700px);position:relative;overflow:hidden}#model :global(canvas){width:100%;height:100%}@media(max-width:650px){.cards{grid-template-columns:1fr}.cards button{display:flex;align-items:center}.cards img{width:45%}}</style>
<script>
import {createRoofScene} from '../../scripts/roof-scene.js';
import {createRoofAssets} from '../../scripts/roof-assets.js';
import {unpackModel} from '../../../architect/v2/transport.mjs';
const el=id=>document.getElementById(id);
async function open(){
 const buttons=[...document.querySelectorAll('button[data-id]')];
 const fetchJSON=async path=>{const r=await fetch(path);if(!r.ok)throw Error(path);return r.json()};
 const models=new Map(await Promise.all(buttons.map(async b=>[b.dataset.id,unpackModel(await fetchJSON('./'+b.dataset.id+'.json'))])));
 const catalog=await fetchJSON('/modelos/atelier/catalogo.json');
 const ids=new Set([...models.values()].flatMap(m=>Object.keys(m.materials)));
 const assets=await createRoofAssets(Object.fromEntries([...ids].map(id=>[id,catalog[id]])));
 const view=createRoofScene(el('model'),assets,b=>{if(b)el('status').textContent=b.id+' · '+b.component+' · '+b.origin.join(', ')});
 let active='claraboia';
 function show(){
   const m=models.get(active);view.load(m);const blocks=m.blocks.filter(b=>el('cut').value==='all'||(el('cut').value==='half'?b.x<=0:b.y<=12));
   view.filter(new Set(blocks));view.fit(el('camera').value,m.blocks);view.lighting(false);view.draw();
   for(const b of buttons){b.setAttribute('aria-pressed',String(b.dataset.id===active));if(b.dataset.id===active)el('name').textContent=b.querySelector('strong').textContent}
   el('status').textContent=assets.failures.length?'Texturas indisponíveis · '+assets.failures.join(', '):'Arraste para girar. Selecione um bloco para consultar sua origem.';
   document.body.dataset.ready=active;
 }
 for(const b of buttons)b.onclick=()=>{active=b.dataset.id;show()};
 el('camera').onchange=show;el('cut').onchange=show;show();
}
open().catch(e=>{el('status').textContent='Falha ao abrir a escotilha · '+e.message});
</script></body></html>
