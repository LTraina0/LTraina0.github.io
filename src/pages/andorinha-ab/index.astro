---
import StudioHeader from "../../components/StudioHeader.astro";
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"/><link rel="icon" href="data:,"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Comparação A/B do navio Andorinha V1 no BuildsMine: silhueta da popa, proporção dos mastros e estudos de velas translúcidas."/><title>Andorinha V1 · Testes A e B · BuildsMine</title><link rel="help" href="/inspecao/" title="Inspeção textual e dados públicos"/></head><body>
<StudioHeader active="andorinha-ab"><button id="theme" aria-label="Alternar entre dia e noite" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18V3zM12 3a9 9 0 0 1 0 18"/></svg> <span>Dia</span></button><button id="materials" aria-controls="material-dialog" aria-expanded="false">Materiais</button></StudioHeader>
<main>
  <section class="ab-bar" aria-label="Comparativo A e B da Andorinha V1">
    <div class="ab-tabs" role="navigation" aria-label="Variantes da Andorinha V1">
      <a class="ab-tab" data-var="a" href="/andorinha-ab/?variante=a">Teste A · Velas Orgânicas</a>
      <a class="ab-tab" data-var="b" href="/andorinha-ab/?variante=b">Teste B · Véus Echelman</a>
      <a class="ab-tab" data-var="base" href="/andorinha-ab/?variante=base">Original V1</a>
    </div>
    <p class="ab-note" id="ab-note">Popa curvada + quilha hidrodinâmica + mastros alongados com velame clássico em lã e rasgos translúcidos sutis.</p>
  </section>
  <div id="stage"><div id="canvas" aria-label="Visualização 3D da construção"></div><div id="loading">Preparando a construção…</div><div class="view-tools"><button id="fit" title="Enquadrar construção"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5M8 12h8M12 8v8"/></svg> <span>Enquadrar</span></button><label class="select-wrap"><span class="sr">Vista</span><select id="view"><option value="perspective">Perspectiva</option><option value="front">Frente</option><option value="back">Trás</option><option value="left">Esquerda</option><option value="right">Direita</option><option value="top">Superior</option><option value="bottom">Inferior</option></select></label><button id="grid" aria-pressed="false" title="Cada quadrado corresponde a 1 bloco">Grade</button><button id="drag-mode" aria-pressed="false" title="Modo arraste: Girar. Clique para alternar para Mover (Pan)."><span>Girar</span></button><label class="select-wrap"><span class="sr">Fundo</span><select id="backdrop" aria-label="Fundo do render"><option value="editor" selected>Fundo: Editor</option><option value="classic">Fundo: Clássico</option></select></label></div><p class="hint">Arraste ou 2 dedos para girar · pinça ou roda para zoom · Shift/Alt + arraste move · WASD + Espaço/Shift voa</p><div id="selection" hidden></div></div>
  <div class="timeline"><div class="timeline-heading"><div><strong>Explorar montagem</strong><span id="progress">Preparando…</span></div><label><span class="sr">Parte da construção</span><select id="part"><option value="all">Todas as partes</option></select></label><label><span class="sr">Modo de montagem</span><select id="mode"><option value="all">Construção inteira</option><option value="layer">Por camada</option><option value="block">Por bloco</option></select></label></div><div id="portal-controls" hidden></div><div class="timeline-controls"><button id="prev" aria-label="Passo anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/></svg></button><input type="range" id="step" min="0" max="1" value="1" aria-label="Progresso da montagem"/><button id="next" aria-label="Próximo passo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg></button><span id="step-label">Completa</span></div></div>
</main>
<aside id="material-dialog" aria-label="Materiais" hidden><div class="dialog-head"><div><h2>Materiais</h2><p id="material-summary">Inventário da construção</p></div><button id="close-materials" aria-label="Fechar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div><div id="material-list"></div><details class="origin-settings"><summary>Coordenadas no mundo</summary><p>Opcional: informe o X, Y e Z do canto local (0, 0, 0). Os eixos seguem a orientação da estrutura extraída.</p><form id="origin-form"><div class="origin-fields"><label>X<input id="origin-x" type="number" step="1"/></label><label>Y<input id="origin-y" type="number" step="1"/></label><label>Z<input id="origin-z" type="number" step="1"/></label></div><button type="submit">Aplicar origem</button><span id="origin-status" role="status"></span></form></details><p id="texture-status" role="status"></p><p class="note">Texturas da Mojang carregadas da fonte oficial quando disponíveis; detalhes podem ser aproximados. Não simula mecanismos.</p></aside>
<script>
  const notes = {
    a: 'Teste A · Popa com cobertura arqueada e quilha hidrodinâmica (sem rampa pendente), mastros reforçados/alongados, estais aterrados, bujarrona frontal e rasgos translúcidos sutis.',
    b: 'Teste B · Véus translúcidos inspirados em Janet Echelman: bujarrona e bordas das velas com blocos coloridos intensos, véu catenário espesso entre mastros e fitas longas.',
    base: 'Original V1 · Versão de referência atual antes dos refinamentos da silhueta da popa, proporção dos mastros e estudos de movimento.'
  };
  const params = new URLSearchParams(location.search);
  const current = ['a', 'b', 'base'].includes(params.get('variante')) ? params.get('variante') : 'a';
  const noteEl = document.querySelector('#ab-note');
  if (noteEl) noteEl.textContent = notes[current];
  for (const tab of document.querySelectorAll('.ab-tab')) {
    const v = tab.dataset.var;
    if (v === current) tab.setAttribute('aria-current', 'page');
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      const next = new URL(location.href);
      next.searchParams.set('variante', v);
      next.searchParams.set('theme', document.body.classList.contains('dark') ? 'night' : 'day');
      const bd = document.querySelector('#backdrop')?.value;
      if (bd) next.searchParams.set('fundo', bd);
      location.assign(next);
    });
  }
</script>
<script src="../../scripts/studio-entry.js"></script><style is:global>@import '../../styles/site.css';@import '../../styles/inventory.css';</style></body></html>

<style>
.ab-bar{background:var(--panel);border:3px solid;border-color:var(--hi) var(--lo) var(--lo) var(--hi);padding:9px 14px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px 16px;box-shadow:2px 2px 0 #0002}
.ab-tabs{display:flex;flex-wrap:wrap;gap:7px}
.ab-tab{display:inline-flex;align-items:center;text-decoration:none;color:var(--ink);background:var(--button);border:2px solid;border-color:var(--hi) var(--lo) var(--lo) var(--hi);padding:6px 11px;font-size:12px;font-weight:600;box-shadow:0 1px 0 #292d29}
.ab-tab:hover{background:color-mix(in srgb,var(--button) 82%,white)}
.ab-tab[aria-current="page"]{border-color:var(--lo) var(--hi) var(--hi) var(--lo);background:#8da67c;box-shadow:none}
.ab-tab:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.ab-note{margin:0;flex:1;min-width:240px;font-size:12px;color:var(--muted);line-height:1.35}
body.dark .ab-tab[aria-current="page"]{background:#657958;color:#eef4eb}
@media(max-width:600px){.ab-bar{padding:7px 9px;gap:6px}.ab-tab{font-size:11px;padding:5px 8px}.ab-note{font-size:11px;min-width:0}}
</style>
